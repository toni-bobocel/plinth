{
  "name": "@plinth/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/telemetry.ts src/server.ts",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@plinth/db": "workspace:*",
    "hono": "^4.13.21",
    "import-in-the-middle": "3.6.0",
    "kysely": "^0.29.9",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
