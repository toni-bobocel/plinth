# The API connects as plinth_app, which is subject to row-level security.
DATABASE_URL=postgres://plinth_app:plinth_app@localhost:5432/plinth
DATABASE_POOL_MAX=10

# Migrations need the owner role; plinth_app cannot create tables.
MIGRATION_DATABASE_URL=postgres://plinth:plinth@localhost:5432/plinth

PORT=8787
LOG_LEVEL=info
SESSION_TTL_DAYS=30

# Leave empty to disable tracing.
OTEL_SERVICE_NAME=plinth-api
OTEL_EXPORTER_OTLP_ENDPOINT=
